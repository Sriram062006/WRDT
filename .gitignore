# ================================
# WRDT - Root Git Ignore
# ================================

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/

# Node
node_modules/
dist/
build/
.vite/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Local databases / temporary files
*.sqlite
*.sqlite3
*.db

# Test / temporary exports
*.tmp
*.temp
