# Copy to .env (local dev) or set as real environment variables (production).
# NEVER commit a real .env. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY and JWT_SECRET_KEY must be two DIFFERENT values.

APP_NAME=WRDT Backend
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of exact browser origins allowed to call the API.
# Not needed if the frontend and API share one origin behind a reverse proxy.
CORS_ORIGINS=http://localhost:5173

# --- Database (Supabase Postgres or any PostgreSQL 14+) ---
# App connection (asyncpg). On Supabase use the pooled/transaction string (port 6543).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
# Used ONLY by Alembic migrations. On Supabase use the direct string (port 5432).
DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
# true for Supabase's transaction pooler (port 6543); false for a direct connection.
DB_DISABLE_STATEMENT_CACHE=true
# Optional least-privilege role the API connects as. If set AND the role exists,
# migration 0004 makes audit_logs append-only for it. Leave blank to skip.
APP_DB_ROLE=

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
